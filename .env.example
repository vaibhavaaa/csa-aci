# ─────────────────────────────────────────────────────────────
# CSA-ACI environment configuration
# Copy to backend/.env and fill real values. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Deployment environment ──
# Use "production" for any real deploy — it makes a missing SECRET_KEY fatal.
ENV=development

# ── Database (required) ──
# Local dev (docker-compose): postgresql://csa:csa@localhost:5432/csa_db
# Tests fall back to sqlite:///:memory: automatically.
DATABASE_URL=postgresql://csa:csa@localhost:5432/csa_db

# ── Auth / JWT ──
# Required when ENV=production (the app refuses to start without it). In dev,
# an ephemeral key is auto-generated if unset. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis (WebSocket pub/sub) ──
REDIS_URL=redis://localhost:6379

# ── CORS — comma-separated allow-list. NO "*" in production. ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite) — base URL of the backend API ──
# Empty string = same origin (when served behind nginx).
VITE_API_URL=http://localhost:8000
