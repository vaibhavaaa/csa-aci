# ─────────────────────────────────────────────────────────────
# CSA-ACI environment configuration
# Copy to backend/.env and fill real values. Never commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── Database (required) ──
# Local dev (docker-compose): postgresql://csa:csa@localhost:5432/csa_db
# Tests fall back to sqlite:///:memory: automatically.
DATABASE_URL=postgresql://csa:csa@localhost:5432/csa_db

# ── Auth / JWT ──
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis (WebSocket pub/sub) ──
REDIS_URL=redis://localhost:6379

# ── CORS — comma-separated allow-list. NO "*" in production. ──
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite) — base URL of the backend API ──
# Empty string = same origin (when served behind nginx).
VITE_API_URL=http://localhost:8000
